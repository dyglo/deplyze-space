{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "deplyze-space-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
    },
    "redact_query_string": true,
  },
  "triggers": {
    "crons": ["*/15 * * * *"],
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://deplyze-space-staging-next-q.vercel.app,https://deplyze-space-staging-f8p15brto-next-q.vercel.app,https://deplyze-space-staging.vercel.app,https://deplyze-space-staging-9j1pyisgw-next-q.vercel.app",
    "SHARE_ORIGIN": "https://deplyze-space-staging-next-q.vercel.app",
    "R2_ACCOUNT_ID": "b6683d42632a146d7b07fad1a528a8cb",
    "R2_BUCKET": "deplyze-space-staging",
    "UPLOADS_ENABLED": "true",
    "R2_ENDPOINT": "",
    "PASSWORD_KDF_URL": "https://deplyze-space-staging-next-q.vercel.app/api/internal/password",
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "deplyze-space-staging",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deplyze-space-staging",
      "database_id": "a372c702-cb31-429d-ad69-a6c4d142f534",
      "migrations_dir": "migrations",
    },
  ],
  "secrets": {
    "required": ["SIGNING_SECRET", "R2_ACCESS_KEY_ID", "R2_SECRET_ACCESS_KEY", "PASSWORD_KDF_SECRET"],
  },
  "alias": {
    "@aws-sdk/xml-builder": "@aws-sdk/xml-builder/dist-cjs/index.js",
  },
  "account_id": "b6683d42632a146d7b07fad1a528a8cb",
}
